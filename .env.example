# ─────────────────────────────────────────────────────────────────────────────
# WhatsNexus frontend — Meta Embedded Signup (browser-safe values ONLY)
#
# This template lists ONLY the Embedded Signup variables. Both are optional: the
# backend issues the app id / config id at launch and is authoritative. When set,
# these are compared with the backend's values so a mismatched deployment is caught
# before it breaks auth-code exchange.
#
# NEVER put the Meta App Secret, a system-user token, or any backend credential in a
# NEXT_PUBLIC_* variable — they are shipped to every browser.
# ─────────────────────────────────────────────────────────────────────────────

# Public Meta App ID used by the Facebook JS SDK
NEXT_PUBLIC_WHATSNEXUS_META_APP_ID=

# Single Embedded Signup Login Configuration ID — used for Standard AND Coexistence.
# The mode (Feature Type) is chosen at launch from the server-side onboarding mode.
NEXT_PUBLIC_WHATSNEXUS_EMBEDDED_SIGNUP_CONFIG_ID=

# The Graph API version comes from the backend start response, so no
# NEXT_PUBLIC_*GRAPH_API_VERSION variable is needed.
